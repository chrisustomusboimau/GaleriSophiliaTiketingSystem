{
  "version": 2,
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/vite"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/main.py" },
    { "src": "/auth/(.*)", "dest": "api/main.py" },
    { "src": "/users/(.*)", "dest": "api/main.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}